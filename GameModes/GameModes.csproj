<Project Sdk="Microsoft.NET.Sdk">

  <!-- Import system-specific properties, or the defaults for this system -->
  <Import Project="env.props" Condition="Exists('env.props')" />
  <Import Project="env.props.windows-template" Condition="!Exists('env.props') AND '$(OS)' != 'Unix'" />
  <Import Project="env.props.unix-template" Condition="!Exists('env.props') AND '$(OS)' == 'Unix'" />

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>GameModes</AssemblyName>
    <RootNamespace>GameModes</RootNamespace>
    <Version>1.1.0-1.5.0</Version>
    <TimberbornTargetVersion>1.1</TimberbornTargetVersion>
    <LangVersion>latest</LangVersion>
    <RunPostBuildEvent>OnBuildSuccess</RunPostBuildEvent>
    <ModPath>$(DocumentsPath)Timberborn/Mods/GameModes/</ModPath>
    <VersionOutputPath>$(ModPath)version-$(TimberbornTargetVersion)/</VersionOutputPath>
    <TimberbornDataPath Condition="'$(TimberbornDataPath)' == ''">$(TimberbornPath)Timberborn_Data/</TimberbornDataPath>
    <TimberbornManagedPath>$(TimberbornDataPath)Managed/</TimberbornManagedPath>
  </PropertyGroup>

  <Target Name="CheckEnv" BeforeTargets="BeforeBuild">
    <Error Text="TimberbornDataPath property directory not found: copy env.props.*-template to env.props and point it at Timberborn" Condition="!Exists('$(TimberbornDataPath)')" />
    <Error Text="HarmonyPath property directory not found" Condition="!Exists('$(HarmonyPath)')" />
  </Target>

  <ItemGroup>
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.3" ExcludeAssets="runtime">
      <PrivateAssets>all</PrivateAssets>
      <PublicizeCompilerGenerated>false</PublicizeCompilerGenerated>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="System.Collections.Immutable" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="$(HarmonyPath)0Harmony.dll" Private="false" />
    <Reference Include="$(TimberbornManagedPath)Bindito.Core.dll" Publicize="true" Private="false" />
    <Reference Include="$(TimberbornManagedPath)Bindito.Unity.dll" Private="false" />
    <Reference Include="$(TimberbornManagedPath)Newtonsoft.Json.dll" Private="false" />
    <Reference Include="$(TimberbornManagedPath)UnityEngine.*.dll" Publicize="true" Private="false" />
    <Reference Include="$(TimberbornManagedPath)Timberborn.*.dll" Publicize="true" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <None Update="manifest.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="thumbnail.png" CopyToOutputDirectory="Never" />
    <None Update="workshop_data.json" CopyToOutputDirectory="Never" />
    <None Update="Localizations/*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- A test run is using the Mods folder: a build that isn't the run's own would swap the DLL it plays -->
  <PropertyGroup>
    <BBTestLock>$([System.IO.Path]::GetTempPath())bb-run-lock</BBTestLock>
    <InstallBlockedByTests Condition="Exists('$(BBTestLock)') AND '$(BB_HOLDS_LOCK)' != '1'">true</InstallBlockedByTests>
  </PropertyGroup>
  <Target Name="WarnInstallBlocked" AfterTargets="PostBuildEvent" Condition="'$(InstallBlockedByTests)' == 'true'">
    <Warning Text="A test run holds $(BBTestLock): not installing into the Mods folder. Build again once it is done." />
  </Target>

  <!-- PostBuild: lay the mod out in Timberborn's Mods folder -->
  <Target Name="PostBuild" AfterTargets="PostBuildEvent" Condition="'$(InstallBlockedByTests)' != 'true'">
    <Message Importance="High" Text="DestinationFolder -&gt; $(VersionOutputPath)" />
    <ItemGroup>
      <FilesToCopy Include="$(ProjectDir)$(OutDir)*" Exclude="$(ProjectDir)$(OutDir)0Harmony.*;$(ProjectDir)$(OutDir)System.*" />
      <LocalizationFileToCopy Include="$(ProjectDir)$(OutDir)Localizations/*" />
      <RootDirFilesToCopy Include="$(ProjectDir)thumbnail.png" Condition="Exists('$(ProjectDir)thumbnail.png')" />
      <!-- The Steam Workshop item to update: the uploader writes it into the mod folder on the first upload -->
      <RootDirFilesToCopy Include="$(ProjectDir)workshop_data.json" Condition="Exists('$(ProjectDir)workshop_data.json')" />
    </ItemGroup>
    <RemoveDir Directories="$(VersionOutputPath)" />
    <MakeDir Directories="$(VersionOutputPath)" />
    <!-- The manifest only carries major.minor (a different manifest version makes the game warn on every save); the real version is here and in the DLL -->
    <WriteLinesToFile File="$(VersionOutputPath)version.txt" Lines="$(Version)" Overwrite="true" />
    <Copy SourceFiles="@(FilesToCopy)" DestinationFolder="$(VersionOutputPath)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(LocalizationFileToCopy)" DestinationFolder="$(VersionOutputPath)Localizations" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(RootDirFilesToCopy)" DestinationFolder="$(ModPath)" SkipUnchangedFiles="true" />
  </Target>

</Project>
